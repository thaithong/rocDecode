+ static void va_MessagingInit()
+ {
+     char env_value[1024];
+     int ret;
+ 
+     if (va_parseConfig("LIBVA_MESSAGING_LEVEL", &env_value[0]) == 0) {
+         ret = sscanf(env_value, "%d", &default_log_level);
+         if (ret < 1 || default_log_level < 0 || default_log_level > 2)
+             default_log_level = 2;
+     }
+ }
