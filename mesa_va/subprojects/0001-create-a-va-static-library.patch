+ static inline int
+ va_getDriverInitName(char *name, int namelen, int major, int minor)
+ {
+     int ret = snprintf(name, namelen, "__vaDriverInit_%d_%d", major, minor);
+     return ret > 0 && ret < namelen;
+ }
